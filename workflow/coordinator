#!/usr/bin/env bash
# Deterministic Development Workflow Coordinator V1: M1 run contract only.
set -euo pipefail

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=workflow/lib/run-paths.sh
source "$repo/workflow/lib/run-paths.sh"
# shellcheck source=workflow/lib/manifest.sh
source "$repo/workflow/lib/manifest.sh"
# shellcheck source=workflow/lib/state.sh
source "$repo/workflow/lib/state.sh"
# shellcheck source=workflow/lib/policy.sh
source "$repo/workflow/lib/policy.sh"
# shellcheck source=workflow/lib/artifacts.sh
source "$repo/workflow/lib/artifacts.sh"
# shellcheck source=workflow/lib/validator.sh
source "$repo/workflow/lib/validator.sh"
# shellcheck source=workflow/lib/agent-runner.sh
source "$repo/workflow/lib/agent-runner.sh"
source "$repo/workflow/lib/workflow.sh"

usage() {
	cat >&2 <<'USAGE'
Usage:
  workflow/coordinator create-run --repository-root PATH --worktree-path PATH --branch NAME --base-sha SHA --milestone-file PATH [--model PROVIDER/MODEL] [--validation-profile repository-tests] [--max-fix-attempts N] [--max-review-rounds N] [--runs-dir PATH]
  workflow/coordinator status --run-dir PATH
  workflow/coordinator transition --run-dir PATH --to PHASE
  workflow/coordinator acquire-writer --run-dir PATH --role implementer|fixer
  workflow/coordinator release-writer --run-dir PATH
  workflow/coordinator check-command -- COMMAND [ARG ...]
  workflow/coordinator validate --run-dir PATH --attempt N [--timeout-ms N] [--max-output-bytes N]
  workflow/coordinator run-agent --run-dir PATH --role implementer|reviewer|fixer [--attempt N] [--timeout-ms N]
  workflow/coordinator run --run-dir PATH [--timeout-ms N]
USAGE
}

require_directory() {
	[ -d "$1" ] || { printf 'workflow: directory does not exist: %s\n' "$1" >&2; exit 2; }
}

require_file() {
	[ -f "$1" ] || { printf 'workflow: file does not exist: %s\n' "$1" >&2; exit 2; }
}

require_nonnegative_integer() {
	[[ $1 =~ ^[0-9]+$ ]] || { printf 'workflow: expected a non-negative integer: %s\n' "$1" >&2; exit 2; }
}

create_run() {
	local repository_root='' worktree_path='' branch='' base_sha='' milestone_file='' model='openai-codex/gpt-5.6-terra' validation_profile='repository-tests' max_fix_attempts=2 max_review_rounds=1 runs_dir="$(workflowRunsDirectory)" run_id run_dir
	while [ $# -gt 0 ]; do
		case "$1" in
		--repository-root|--worktree-path|--branch|--base-sha|--milestone-file|--model|--validation-profile|--max-fix-attempts|--max-review-rounds|--runs-dir)
			[ $# -ge 2 ] || { usage; exit 2; }
			case "$1" in
			--repository-root) repository_root=$2 ;;
			--worktree-path) worktree_path=$2 ;;
			--branch) branch=$2 ;;
			--base-sha) base_sha=$2 ;;
			--milestone-file) milestone_file=$2 ;;
			--model) model=$2 ;;
			--validation-profile) validation_profile=$2 ;;
			--max-fix-attempts) max_fix_attempts=$2 ;;
			--max-review-rounds) max_review_rounds=$2 ;;
			--runs-dir) runs_dir=$2 ;;
			esac
			shift 2
			;;
		*) usage; exit 2 ;;
		esac
	done
	[ -n "$repository_root" ] && [ -n "$worktree_path" ] && [ -n "$branch" ] && [ -n "$base_sha" ] && [ -n "$milestone_file" ] || { usage; exit 2; }
	require_directory "$repository_root"
	require_directory "$worktree_path"
	require_file "$milestone_file"
	require_nonnegative_integer "$max_fix_attempts"
	require_nonnegative_integer "$max_review_rounds"
	workflowPolicyValidateProfile "$validation_profile"
	repository_root=$(cd -P "$repository_root" && pwd)
	worktree_path=$(cd -P "$worktree_path" && pwd)
	milestone_file=$(cd -P "$(dirname "$milestone_file")" && pwd)/$(basename "$milestone_file")
	mkdir -p "$runs_dir"
	run_id=$(workflowRunId)
	run_dir="$runs_dir/$run_id"
	mkdir "$run_dir" || { printf 'workflow: could not create run directory: %s\n' "$run_dir" >&2; exit 1; }
	mkdir -p "$run_dir/artifacts/diff" "$run_dir/artifacts/validation" "$run_dir/prompts" "$run_dir/reviews" "$run_dir/reports"
	workflowWriteManifest "$run_dir/manifest.json" "$run_id" "$repository_root" "$worktree_path" "$branch" "$base_sha" "$milestone_file" "$model" "$validation_profile" "$max_fix_attempts" "$max_review_rounds"
	workflowWriteInitialState "$run_dir/state.json"
	printf '%s\n' "$run_dir"
}

require_run_option() {
	[ "${1:-}" = --run-dir ] && [ $# -eq 2 ] || { usage; exit 2; }
	workflowRequireRunDirectory "$2"
}

acquire_writer() {
	local run_dir='' writer_role='' runs_dir worktree_path lock_dir
	while [ $# -gt 0 ]; do
		case "$1" in
		--run-dir|--role) [ $# -ge 2 ] || { usage; exit 2; }; [ "$1" = --run-dir ] && run_dir=$2 || writer_role=$2; shift 2 ;;
		*) usage; exit 2 ;;
		esac
	done
	workflowRequireRunDirectory "$run_dir"
	case "$writer_role" in implementer|fixer) ;; *) usage; exit 2 ;; esac
	case "$(workflowStateField "$run_dir/state.json" '.phase')" in implementing|fixing) ;; *) printf 'workflow: writers require implementing or fixing phase\n' >&2; exit 1 ;; esac
	runs_dir=$(dirname "$run_dir")
	worktree_path=$(workflowStateField "$run_dir/manifest.json" '.worktree_path')
	lock_dir=$(workflowWorktreeLockDirectory "$runs_dir" "$worktree_path")
	mkdir -p "$(dirname "$lock_dir")"
	if ! mkdir "$lock_dir" 2>/dev/null; then
		printf 'workflow: writer is already active for worktree: %s\n' "$worktree_path" >&2
		exit 1
	fi
	printf '%s\n' "$(workflowStateField "$run_dir/manifest.json" '.run_id')" >"$lock_dir/run-id"
	printf '%s\n' "$worktree_path" >"$lock_dir/worktree-path"
	workflowSetWriterState "$run_dir/state.json" "$writer_role"
}

validate_run() {
	local run_dir='' attempt='' timeout_ms="$(workflowValidationTimeoutMs)" max_output_bytes="$(workflowValidationOutputLimitBytes)"
	while [ $# -gt 0 ]; do
		case "$1" in
		--run-dir|--attempt|--timeout-ms|--max-output-bytes)
			[ $# -ge 2 ] || { usage; exit 2; }
			case "$1" in
			--run-dir) run_dir=$2 ;;
			--attempt) attempt=$2 ;;
			--timeout-ms) timeout_ms=$2 ;;
			--max-output-bytes) max_output_bytes=$2 ;;
			esac
			shift 2
			;;
		*) usage; exit 2 ;;
		esac
	done
	[ -n "$run_dir" ] && [ -n "$attempt" ] || { usage; exit 2; }
	require_nonnegative_integer "$attempt"
	require_nonnegative_integer "$timeout_ms"
	require_nonnegative_integer "$max_output_bytes"
	[ "$timeout_ms" -gt 0 ] && [ "$max_output_bytes" -gt 0 ] || { printf 'workflow: timeout and output limit must be positive\n' >&2; exit 2; }
	workflowRequireRunDirectory "$run_dir"
	exec bash -c 'source "$1/workflow/lib/validator.sh"; source "$1/workflow/lib/artifacts.sh"; source "$1/workflow/lib/policy.sh"; source "$1/workflow/lib/state.sh"; workflowRunValidation "$1" "$2" "$3" "$4" "$5" "$6"' workflow-validator "$repo" "$run_dir" "$attempt" "$timeout_ms" "$max_output_bytes"
}

run_agent() {
	local run_dir='' role='' attempt=0 timeout_ms=120000
	while [ $# -gt 0 ]; do
		case "$1" in
		--run-dir|--role|--attempt|--timeout-ms)
			[ $# -ge 2 ] || { usage; exit 2; }
			case "$1" in --run-dir) run_dir=$2 ;; --role) role=$2 ;; --attempt) attempt=$2 ;; --timeout-ms) timeout_ms=$2 ;; esac
			shift 2 ;;
		*) usage; exit 2 ;;
		esac
	done
	[ -n "$run_dir" ] && [ -n "$role" ] || { usage; exit 2; }
	require_nonnegative_integer "$attempt"; require_nonnegative_integer "$timeout_ms"
	[ "$timeout_ms" -gt 0 ] || { usage; exit 2; }
	workflowRequireRunDirectory "$run_dir"
	workflowRunAgent "$repo" "$run_dir" "$role" "$attempt" "$timeout_ms"
}

run_workflow() {
 local run_dir='' timeout_ms=120000
 while [ $# -gt 0 ]; do case "$1" in --run-dir|--timeout-ms) [ $# -ge 2 ] || { usage; exit 2; }; [ "$1" = --run-dir ] && run_dir=$2 || timeout_ms=$2; shift 2;; *) usage; exit 2;; esac; done
 [ -n "$run_dir" ] || { usage; exit 2; }; require_nonnegative_integer "$timeout_ms"; [ "$timeout_ms" -gt 0 ] || exit 2; workflowRequireRunDirectory "$run_dir"
 workflowRunV1 "$repo" "$run_dir" "$timeout_ms"
}

release_writer() {
	local run_dir='' runs_dir worktree_path lock_dir owner
	[ "${1:-}" = --run-dir ] && [ $# -eq 2 ] || { usage; exit 2; }
	run_dir=$2
	workflowRequireRunDirectory "$run_dir"
	runs_dir=$(dirname "$run_dir")
	worktree_path=$(workflowStateField "$run_dir/manifest.json" '.worktree_path')
	lock_dir=$(workflowWorktreeLockDirectory "$runs_dir" "$worktree_path")
	[ -d "$lock_dir" ] || { printf 'workflow: writer lock is not held\n' >&2; exit 1; }
	owner=$(<"$lock_dir/run-id")
	[ "$owner" = "$(workflowStateField "$run_dir/manifest.json" '.run_id')" ] || { printf 'workflow: writer lock belongs to another run\n' >&2; exit 1; }
	rm -rf "$lock_dir"
	workflowSetWriterState "$run_dir/state.json" null
}

case "${1:-}" in
create-run) shift; create_run "$@" ;;
status) shift; require_run_option "$@"; cat "$2/state.json" ;;
transition)
	shift
	[ "${1:-}" = --run-dir ] && [ "${3:-}" = --to ] && [ $# -eq 4 ] || { usage; exit 2; }
	workflowRequireRunDirectory "$2"
	workflowTransitionState "$2/state.json" "$4"
	;;
acquire-writer) shift; acquire_writer "$@" ;;
release-writer) shift; release_writer "$@" ;;
check-command)
	shift
	[ "${1:-}" = -- ] || { usage; exit 2; }
	shift
	[ $# -gt 0 ] || { usage; exit 2; }
	workflowPolicyRejectCommand "$@"
	;;
validate) shift; validate_run "$@" ;;
run-agent) shift; run_agent "$@" ;;
run) shift; run_workflow "$@" ;;
*) usage; exit 2 ;;
esac
