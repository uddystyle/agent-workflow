{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Workflow Coordinator V1 deterministic validation attempt",
  "type": "object",
  "required": ["schema_version", "attempt", "command_id", "started_at", "finished_at", "outcome", "exit_code", "timed_out", "cancelled", "truncated", "sanitization", "stdout_path", "stderr_path", "diff_path"],
  "properties": {
    "schema_version": { "const": 1 },
    "attempt": { "type": "integer", "minimum": 0 },
    "command_id": { "const": "repository-tests" },
    "outcome": { "enum": ["pass", "fail", "timeout", "cancelled", "truncated", "unsafe-artifact", "unknown"] },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "cancelled": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "sanitization": { "enum": ["succeeded", "failed"] }
  }
}
