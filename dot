#!/usr/bin/env bash
# 参考先の init / update / doctor / stow。管理対象は Herdr＋Pi に限定する。
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
usage() { printf 'Usage: ./dot {init|update|stow|doctor}\n'; }
need() { command -v "$1" >/dev/null 2>&1 || { printf '必要なコマンドが無い: %s\n' "$1" >&2; exit 1; }; }

# 以前配ったPi同梱subagentだけを撤去する。別管理の同居物は残す。
remove_retired_subagent() {
 local dest file current
 dest="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions/subagent"
 for file in index.ts agents.ts; do
  [ -L "$dest/$file" ] || continue
  current=$(readlink "$dest/$file")
  case "$current" in
   */@earendil-works/pi-coding-agent/examples/extensions/subagent/"$file") rm "$dest/$file" ;;
  esac
 done
 rmdir "$dest" 2>/dev/null || true
}

stow_config() {
 # install.sh と同じ既定の HOME 配置だけをこの入口が管理する。
 if [ -n "${PI_CODING_AGENT_DIR:-}" ] && [ "$PI_CODING_AGENT_DIR" != "$HOME/.pi/agent" ]; then
  printf 'カスタム PI_CODING_AGENT_DIR は未対応。既定 HOME へ配信する入口です\n' >&2
  return 1
 fi
 mkdir -p "$HOME/.pi/agent/skills"
 bash "$repo/install.sh"
 remove_retired_subagent
}

trust_brew_formulae() {
 brew trust --formula plannotator/tap/plannotator-tui
}

ensure_pi_packages() {
 need pi; need python3
 local source settings="$HOME/.pi/agent/settings.json"
 while IFS= read -r source || [ -n "$source" ]; do
  source=${source%%#*}
  source=${source//[[:space:]]/}
  [ -n "$source" ] || continue
  if ! PI_PACKAGE_SOURCE="$source" PI_SETTINGS="$settings" python3 - <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(os.environ["PI_SETTINGS"])
try:
    packages = json.loads(path.read_text()).get("packages", [])
except (OSError, ValueError):
    sys.exit(1)
source = os.environ["PI_PACKAGE_SOURCE"]
for package in packages:
    configured = package if isinstance(package, str) else package.get("source") if isinstance(package, dict) else None
    if configured == source:
        sys.exit(0)
sys.exit(1)
PY
  then
   pi install "$source"
  fi
 done <"$repo/packages/pi-packages.txt"

 local extmgr_cache="$HOME/.pi/agent/.extmgr-cache"
 if [ ! -e "$extmgr_cache/auto-update.json" ]; then
  mkdir -p "$extmgr_cache"
  cp "$repo/packages/pi-extmgr-auto-update.json" "$extmgr_cache/auto-update.json"
 fi
}

integrations() {
 need herdr
 herdr integration install pi
 local source
 while IFS= read -r source || [ -n "$source" ]; do
  source=${source%%#*}
  source=${source//[[:space:]]/}
  [ -n "$source" ] || continue
  herdr plugin install "$source" --yes
 done <"$repo/home/.config/herdr/plugins.txt"
 # 動いている session を変更・再起動しない。reload は利用者が行う。
}

case "${1:-help}" in
 help|--help|-h) usage ;;
 init|update|stow|doctor)
  [ "$#" -eq 1 ] || { usage >&2; exit 2; }
  case "$1" in
   init)
    # Homebrew 自体の bootstrap は https://brew.sh/ の手順で行う。
    need brew
    trust_brew_formulae
    brew bundle install --no-upgrade --file="$repo/packages/Brewfile"
    need npm
    if ! command -v pi >/dev/null 2>&1; then
     npm install -g --ignore-scripts @earendil-works/pi-coding-agent
    fi
    ensure_pi_packages
    stow_config
    integrations
    ;;
   update)
    need git; need brew; need pi
    [ -z "$(git -C "$repo" status --porcelain)" ] || { printf '変更を commit または退避してから update する\n' >&2; exit 1; }
    git -C "$repo" pull --ff-only
    brew update
    trust_brew_formulae
    brew bundle install --file="$repo/packages/Brewfile"
    ensure_pi_packages
    pi update --all
    stow_config
    integrations
    ;;
   stow) stow_config ;;
   doctor) bash "$repo/tests/doctor.sh" ;;
  esac
  ;;
 *) usage >&2; exit 2 ;;
esac
