#!/usr/bin/env bash
# 参考先の init / update / doctor / stow。管理対象は Herdr＋Pi に限定する。
set -euo pipefail
repo=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
usage() { printf 'Usage: ./dot {init|update|stow|doctor}\n'; }
need() { command -v "$1" >/dev/null 2>&1 || { printf '必要なコマンドが無い: %s\n' "$1" >&2; exit 1; }; }

# 以前配ったPi同梱subagentだけを撤去する。別管理の同居物は残す。
remove_retired_subagent() {
 local dest file current
 dest="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/extensions/subagent"
 for file in index.ts agents.ts; do
  [ -L "$dest/$file" ] || continue
  current=$(readlink "$dest/$file")
  case "$current" in
   */@earendil-works/pi-coding-agent/examples/extensions/subagent/"$file") rm "$dest/$file" ;;
  esac
 done
 rmdir "$dest" 2>/dev/null || true
}

stow_config() {
 # install.sh と同じ既定の HOME 配置だけをこの入口が管理する。
 if [ -n "${PI_CODING_AGENT_DIR:-}" ] && [ "$PI_CODING_AGENT_DIR" != "$HOME/.pi/agent" ]; then
  printf 'カスタム PI_CODING_AGENT_DIR は未対応。既定 HOME へ配信する入口です\n' >&2
  return 1
 fi
 mkdir -p "$HOME/.pi/agent/skills"
 bash "$repo/install.sh"
 remove_retired_subagent
}

trust_brew_formulae() {
 brew trust --formula plannotator/tap/plannotator-tui
}

pi_package_configured() {
 PI_PACKAGE_SOURCE="$1" PI_SETTINGS="$HOME/.pi/agent/settings.json" python3 - <<'PY'
import json, os, pathlib, sys
path = pathlib.Path(os.environ["PI_SETTINGS"])
try:
    packages = json.loads(path.read_text()).get("packages", [])
except (OSError, ValueError):
    sys.exit(1)
source = os.environ["PI_PACKAGE_SOURCE"]
# Piはlocal packageをsettingsからの相対pathで記録するため、pathはsettingsの位置から解決して比べる。
def resolve(value):
    if value.startswith(("/", ".", "~")):
        return os.path.realpath(os.path.join(path.parent, os.path.expanduser(value)))
    return value
for package in packages:
    configured = package if isinstance(package, str) else package.get("source") if isinstance(package, dict) else None
    if isinstance(configured, str) and resolve(configured) == resolve(source):
        sys.exit(0)
sys.exit(1)
PY
}

ensure_pi_packages() {
 need pi; need python3
 local source
 while IFS= read -r source || [ -n "$source" ]; do
  source=${source%%#*}
  source=${source//[[:space:]]/}
  [ -n "$source" ] || continue
  pi_package_configured "$source" || pi install "$source"
 done <"$repo/packages/pi-packages.txt"
}

manifest_value() {
 sed -n "s/^$2=//p" "$1" | head -n 1
}

# herdr-codemodeはrepo外へ取得し、固定commitのlocal Pi packageとして登録する。D-35
ensure_herdr_codemode() {
 need git; need npm; need pi; need python3
 local manifest="$repo/packages/herdr-codemode.txt" source commit workspace package checkout
 source=$(manifest_value "$manifest" repo)
 commit=$(manifest_value "$manifest" commit)
 workspace=$(manifest_value "$manifest" workspace)
 package=$(manifest_value "$manifest" package)
 checkout="${XDG_DATA_HOME:-$HOME/.local/share}/agent-workflow/herdr-codemode"
 if [ ! -d "$checkout/.git" ]; then
  git clone --quiet --filter=blob:none "$source" "$checkout"
 fi
 [ -z "$(git -C "$checkout" status --porcelain)" ] || {
  printf 'herdr-codemodeの取得先に手の変更がある。確認してから戻す: %s\n' "$checkout" >&2
  return 1
 }
 if [ "$(git -C "$checkout" rev-parse HEAD)" != "$commit" ]; then
  git -C "$checkout" fetch --quiet origin
  git -C "$checkout" checkout --quiet --detach "$commit"
  rm -rf "${checkout:?}/$workspace/node_modules"
 fi
 [ -d "$checkout/$workspace/node_modules" ] || npm ci --prefix "$checkout/$workspace" --ignore-scripts --no-audit --no-fund
 pi_package_configured "$checkout/$package" || pi install "$checkout/$package"
 # herdr_* はcodemodeのscriptからだけ呼べる。既存のdefaultToolsは保ち、codemodeだけを足す。
 PI_SETTINGS="$HOME/.pi/agent/settings.json" python3 - <<'PY'
import json, os, pathlib
path = pathlib.Path(os.environ["PI_SETTINGS"])
settings = json.loads(path.read_text()) if path.exists() else {}
tools = settings.get("defaultTools")
if tools is None:
    settings["defaultTools"] = ["+codemode"]
elif "codemode" in tools or "+codemode" in tools:
    raise SystemExit(0)
else:
    tools.append("+codemode" if all(tool.startswith(("+", "-")) for tool in tools) else "codemode")
path.parent.mkdir(parents=True, exist_ok=True)
temp = path.with_name(path.name + ".tmp")
temp.write_text(json.dumps(settings, indent=2, ensure_ascii=False) + "\n")
temp.replace(path)
PY
}

integrations() {
 need herdr
 herdr integration install pi
 local source
 while IFS= read -r source || [ -n "$source" ]; do
  source=${source%%#*}
  source=${source//[[:space:]]/}
  [ -n "$source" ] || continue
  herdr plugin install "$source" --yes
 done <"$repo/home/.config/herdr/plugins.txt"
 # 動いている session を変更・再起動しない。reload は利用者が行う。
}

case "${1:-help}" in
 help|--help|-h) usage ;;
 init|update|stow|doctor)
  [ "$#" -eq 1 ] || { usage >&2; exit 2; }
  case "$1" in
   init)
    # Homebrew 自体の bootstrap は https://brew.sh/ の手順で行う。
    need brew
    trust_brew_formulae
    brew bundle install --no-upgrade --file="$repo/packages/Brewfile"
    need npm
    if ! command -v pi >/dev/null 2>&1; then
     npm install -g --ignore-scripts @earendil-works/pi-coding-agent
    fi
    ensure_pi_packages
    ensure_herdr_codemode
    stow_config
    integrations
    ;;
   update)
    need git; need brew; need pi
    [ -z "$(git -C "$repo" status --porcelain)" ] || { printf '変更を commit または退避してから update する\n' >&2; exit 1; }
    git -C "$repo" pull --ff-only
    brew update
    trust_brew_formulae
    brew bundle install --file="$repo/packages/Brewfile"
    ensure_pi_packages
    pi update --all
    ensure_herdr_codemode
    stow_config
    integrations
    ;;
   stow) stow_config ;;
   doctor) bash "$repo/tests/doctor.sh" ;;
  esac
  ;;
 *) usage >&2; exit 2 ;;
esac
