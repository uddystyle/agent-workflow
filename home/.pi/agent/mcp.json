{
  "settings": {
    "mcpFooterStatus": "compact",
    "hostConfigDiscovery": "off",
    "scriptMode": false,
    "sampling": false,
    "elicitation": false,
    "autoAuth": false
  },
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      },
      "lifecycle": "lazy",
      "requestTimeoutMs": 60000,
      "approveTools": true
    }
  }
}
