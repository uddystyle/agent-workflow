{
  "version": 1,
  "routes": {
    "light": {
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "thinkingLevel": "low"
    },
    "normal": {
      "provider": "openai-codex",
      "model": "gpt-5.6-terra",
      "thinkingLevel": "medium"
    },
    "hard": {
      "provider": "openai-codex",
      "model": "gpt-6-astra",
      "thinkingLevel": "high"
    },
    "very-hard": {
      "provider": "openai-codex",
      "model": "gpt-6-astra",
      "thinkingLevel": "xhigh"
    }
  },
  "fallbackRoute": "normal",
  "hardGate": {
    "patterns": [
      "security",
      "vulnerability",
      "credential",
      "secret",
      "authentication",
      "authorization",
      "migration",
      "schema",
      "production",
      "incident",
      "data loss",
      "destructive"
    ]
  },
  "rollout": {
    "enabledRoutes": ["light"]
  },
  "jev": {
    "model": "jev-1.13.0",
    "timeoutMs": 5000,
    "minimumConfidence": 0.7
  }
}
