# 秘密の形。書き出す瞬間に止めるために使う（DECISIONS.md D-18）。
#
# 1行 = label  kind  pattern  min_len（空白区切りの4つ組）
# kind は prefix か assignment のどちらか。
#
# 🔴 正規表現を持たない。実在する鍵は固定の前置詞を持つので、
#    前置詞の一致と後続の長さで足りる。表現力を足すと誤検知が増える。
#
# prefix      pattern の直後に base64url の文字が min_len 以上続けばヒット
# assignment  pattern の後ろに = か : が来て、空白でない値が min_len 以上続けばヒット
#
# ⚠️ 下限を下げない。下げた分だけ、ただの文章がヒットする。
#    `sk_live_` とだけ書いた文はヒットしない——この表自身が通る理由である。
#
# 2026-09-05 に実測して締めた（D-18 の「足す前に数える」に従った）。
# 実在の repo 1425 ファイルに掛けて 19 件が止まり、本物は 1 件だけだった。
#
#   - assignment の下限 20 → 40。20 では `'service_role_dummy'` のような
#     テストの偽物や `"your_supabase_..."` の穴埋めが当たる。19 件 → 4 件
#   - `re_`（resend の前置詞）を落とした。3 文字では短すぎ、
#     `score_mutations_client_mutation_id_key` のような識別子に当たる。4 件 → 2 件
#     RESEND_API_KEY は assignment の側で見る
#   - 締めても本物は止まったままである。ここが確かめどころだった
#
# ⚠️ 前置詞を足すなら 4 文字以上にする。3 文字は普通の語に当たる。
# ⚠️ `eyJ` も 3 文字なので、長い base64 を書き出すと偶然当たる
#    （133KB の乱数 base64 を 20 回書き出して 12 回）。これは残した——
#    JWT は最も多く漏れる形で、下限 40 を下回る代替が無い。

stripe_secret       prefix      sk_live_    24
stripe_secret       prefix      sk_test_    24
stripe_restricted   prefix      rk_live_    24
stripe_webhook      prefix      whsec_      24
supabase_pat        prefix      sbp_        24
jwt                 prefix      eyJ         40
github_pat          prefix      ghp_        30
openai              prefix      sk-proj-    30
anthropic           prefix      sk-ant-     30

assign_service_role assignment  SUPABASE_SERVICE_ROLE_KEY   40
assign_stripe       assignment  STRIPE_SECRET_KEY           40
assign_webhook      assignment  STRIPE_WEBHOOK_SECRET       40
assign_resend       assignment  RESEND_API_KEY              40
assign_anthropic    assignment  ANTHROPIC_API_KEY           40
assign_openai       assignment  OPENAI_API_KEY              40
