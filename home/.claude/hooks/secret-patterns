# 秘密の形。書き出す瞬間に止めるために使う（DECISIONS.md D-18）。
#
# 1行 = label  kind  pattern  min_len（空白区切りの4つ組）
# kind は prefix か assignment のどちらか。
#
# 🔴 正規表現を持たない。実在する鍵は固定の前置詞を持つので、
#    前置詞の一致と後続の長さで足りる。表現力を足すと誤検知が増える。
#
# prefix      pattern の直後に base64url の文字が min_len 以上続けばヒット
# assignment  pattern の後ろに = か : が来て、空白でない値が min_len 以上続けばヒット
#
# ⚠️ 下限を下げない。下げた分だけ、ただの文章がヒットする。
#    `sk_live_` とだけ書いた文はヒットしない——この表自身が通る理由である。

stripe_secret       prefix      sk_live_    24
stripe_secret       prefix      sk_test_    24
stripe_restricted   prefix      rk_live_    24
stripe_webhook      prefix      whsec_      24
resend              prefix      re_         28
supabase_pat        prefix      sbp_        24
jwt                 prefix      eyJ         40
github_pat          prefix      ghp_        30
openai              prefix      sk-proj-    30
anthropic           prefix      sk-ant-     30

assign_service_role assignment  SUPABASE_SERVICE_ROLE_KEY   20
assign_stripe       assignment  STRIPE_SECRET_KEY           20
assign_webhook      assignment  STRIPE_WEBHOOK_SECRET       20
assign_resend       assignment  RESEND_API_KEY              20
assign_anthropic    assignment  ANTHROPIC_API_KEY           20
assign_openai       assignment  OPENAI_API_KEY              20
